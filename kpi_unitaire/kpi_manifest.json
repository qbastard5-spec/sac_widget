{
  "id": "com.acome.kpi",
  "version": "1.0.0",
  "name": "KPI Card Individuelle",
  "newInstancePrefix": "KPI",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "kpi-card",
      "url": "https://qbastard5-spec.github.io/sac_widget/kpi_unitaire/kpi_widget.js",
      "crossOrigin": "anonymous",
      "integrity": "",
      "ignoreIntegrity": true
    },
    {
      "kind": "styling",
      "tag": "kpi-card-styling",
      "url": "https://qbastard5-spec.github.io/sac_widget/kpi_unitaire/kpi_styling.js",
      "crossOrigin": "anonymous",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "dataBindings": {
    "myData": {
      "feeds": [
        { "id": "value", "description": "Valeur", "type": "MeasureFeed", "min": 1, "max": 1 },
        { "id": "objective", "description": "Objectif", "type": "MeasureFeed", "min": 0, "max": 1 },
        { "id": "label", "description": "Libellé", "type": "DimensionFeed", "min": 0, "max": 1 }
      ]
    }
  },
  "properties": {
    "labelText": { "type": "string", "default": "Indicateur" },
    "colorAbove": { "type": "string", "default": "#27AE60" },
    "colorWarning": { "type": "string", "default": "#E67E22" },
    "colorBelow": { "type": "string", "default": "#C0392B" },
    "warningPct": { "type": "number", "default": 90 },
    "showObjective": { "type": "boolean", "default": true },
    "showVariance": { "type": "boolean", "default": true },
    "varianceMode": { "type": "string", "default": "diff" },
    "bgColor": { "type": "string", "default": "#222840" },
    "borderColor": { "type": "string", "default": "#2a2a3a" },
    "borderWidth": { "type": "number", "default": 1 },
    "borderRadius": { "type": "number", "default": 8 },
    "padding": { "type": "number", "default": 12 },
    "valueFontSize": { "type": "number", "default": 28 },
    "labelFontSize": { "type": "number", "default": 12 },
    "objFontSize": { "type": "number", "default": 11 },
    "labelColor": { "type": "string", "default": "#8899aa" },
    "objColor": { "type": "string", "default": "#667788" }
  },
  "methods": {},
  "events": {}
}
