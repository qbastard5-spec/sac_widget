(() => {
  const template = document.createElement("template");
  template.innerHTML = `
    <style>
      :host { display:flex; align-items:center; justify-content:center; width:100%; height:100%; font-family:sans-serif; }
      .wrap { display:flex; flex-direction:column; align-items:center; width:100%; }
      .lbl  { font-size:0.75em; color:#aaa; margin-top:4px; text-align:center; padding:0 6px; }
    </style>
    <div class="wrap">
      <svg class="svg" viewBox="0 0 200 155" style="width:90%;max-width:240px">
        <path class="track" d="M 22 105 A 78 78 0 0 1 178 105"
          fill="none" stroke="#2a2a3a" stroke-width="13" stroke-linecap="round"/>
        <path class="progress" d="M 22 105 A 78 78 0 0 1 178 105"
          fill="none" stroke-width="13" stroke-linecap="round"/>
        <text class="min-lbl" x="16"  y="120" text-anchor="middle" font-size="9" fill="#555" font-family="sans-serif">0</text>
        <text class="max-lbl" x="184" y="120" text-anchor="middle" font-size="9" fill="#555" font-family="sans-serif">100</text>
        <line class="needle" x1="100" y1="105" x2="100" y2="27" stroke-width="2.5" stroke-linecap="round"/>
        <circle class="pivot" cx="100" cy="105" r="5"/>
        <circle class="tip"   cx="100" cy="27"  r="5"/>
        <line x1="40" y1="120" x2="160" y2="120" stroke="#2a2a3a" stroke-width="1"/>
        <text class="val-txt" x="100" y="138" text-anchor="middle" font-size="22" font-weight="700" font-family="sans-serif">0</text>
        <text class="obj-txt" x="100" y="151" text-anchor="middle" font-size="10" fill="#666" font-family="sans-serif">/ 100</text>
      </svg>
      <div class="lbl">Indicateur</div>
    </div>
  `;

  class SemiGauge extends HTMLElement {
    constructor() {
      super();
      this._root = this.attachShadow({ mode: "open" });
      this._root.appendChild(template.content.cloneNode(true));
      this._value      = 0;
      this._maxValue   = 100;
      this._label      = "Indicateur";
      this._colorAbove = "#27AE60";
      this._colorBelow = "#C0392B";
    }

    // Méthode officielle SAC — appelée après chaque mise à jour de propriété
    onCustomWidgetAfterUpdate(changed) {
      if ("value"      in changed) this._value      = changed["value"];
      if ("maxValue"   in changed) this._maxValue   = changed["maxValue"];
      if ("label"      in changed) this._label      = changed["label"];
      if ("colorAbove" in changed) this._colorAbove = changed["colorAbove"];
      if ("colorBelow" in changed) this._colorBelow = changed["colorBelow"];
      this._render();
    }

    _render() {
      const val   = parseFloat(this._value)    || 0;
      const max   = parseFloat(this._maxValue) || 100;
      const ratio = Math.min(Math.max(val / max, 0), 1);
      const color = val >= max ? this._colorAbove : this._colorBelow;

      const cx = 100, cy = 105, r = 78;
      const angle = Math.PI - ratio * Math.PI;
      const tx = cx + r * Math.cos(angle);
      const ty = cy - r * Math.sin(angle);
      const la = ratio > 0.5 ? 1 : 0;

      let arc;
      if      (ratio <= 0) arc = `M ${cx-r} ${cy} A ${r} ${r} 0 0 1 ${cx-r+0.01} ${cy}`;
      else if (ratio >= 1) arc = `M ${cx-r} ${cy} A ${r} ${r} 0 0 1 ${cx+r} ${cy}`;
      else                 arc = `M ${cx-r} ${cy} A ${r} ${r} 0 ${la} 1 ${tx.toFixed(1)} ${ty.toFixed(1)}`;

      const $ = (s) => this._root.querySelector(s);
      $(".progress").setAttribute("d",      arc);
      $(".progress").setAttribute("stroke", color);
      $(".needle").setAttribute("x2", tx.toFixed(1));
      $(".needle").setAttribute("y2", ty.toFixed(1));
      $(".needle").setAttribute("stroke", color);
      $(".tip").setAttribute("cx", tx.toFixed(1));
      $(".tip").setAttribute("cy", ty.toFixed(1));
      $(".tip").setAttribute("fill", color);
      $(".pivot").setAttribute("fill", color);
      $(".val-txt").textContent = this._fmt(val);
      $(".val-txt").setAttribute("fill", color);
      $(".obj-txt").textContent = "/ " + this._fmt(max);
      $(".max-lbl").textContent = this._fmt(max);
      $(".wrap").querySelector(".lbl").textContent = this._label;
    }

    _fmt(n) { return Number.isInteger(n) ? String(n) : parseFloat(n.toFixed(2)).toString(); }

    connectedCallback() { this._render(); }
  }

  customElements.define("circular-gauge", SemiGauge);
})();
